<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH priced_segments AS&#xa;(&#xa;    SELECT s.station_id,&#xa;           s.station_name,&#xa;           r.period_type,&#xa;           d.segment_energy_kwh,&#xa;           r.electricity_price,&#xa;           r.service_price,&#xa;           d.free_service_fee&#xa;    FROM dbo.ChargingOrder AS o&#xa;    INNER JOIN dbo.ChargingStation AS s&#xa;        ON s.station_id = o.opening_station_id&#xa;    INNER JOIN dbo.BillingRuleVersion AS v&#xa;        ON v.rule_version_id = o.startup_rule_version_id&#xa;       AND v.station_id = o.opening_station_id&#xa;    INNER JOIN dbo.OrderFeeDetail AS d&#xa;        ON d.order_id = o.order_id&#xa;       AND d.segment_start &gt;= @StartInclusive&#xa;       AND d.segment_start &lt; @EndExclusive&#xa;    INNER JOIN dbo.BillingRule AS r&#xa;        ON r.billing_rule_id = d.billing_rule_id&#xa;       AND r.rule_version_id = v.rule_version_id&#xa;    WHERE o.priced_at IS NOT NULL&#xa;      AND (@StationId IS NULL OR o.opening_station_id = @StationId)&#xa;)&#xa;SELECT station_id,&#xa;       station_name,&#xa;       period_type,&#xa;       SUM(segment_energy_kwh) AS energy_kwh,&#xa;       SUM(ROUND(segment_energy_kwh * electricity_price, 2)) AS electricity_amount,&#xa;       SUM(ROUND(segment_energy_kwh * service_price, 2)) AS service_amount_before_free,&#xa;       SUM(free_service_fee) AS free_service_fee,&#xa;       SUM(ROUND(segment_energy_kwh * service_price, 2) - free_service_fee)&#xa;           AS service_amount_after_free&#xa;FROM priced_segments&#xa;GROUP BY station_id, station_name, period_type&#xa;ORDER BY station_id, period_type" StatementId="1" StatementCompId="6" StatementType="SELECT" StatementSqlHandle="0x0900EBB146805AB4C55C92CFCBF17B202DC60000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.0369126" StatementEstRows="9.7337" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xDF3B5FEE022C0E07" QueryPlanHash="0x4C8A0A061CE63E5D" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="0" MemoryGrant="1024" NonParallelPlanReason="NoParallelPlansInDesktopOrExpressEdition" CachedPlanSize="104" CompileTime="28" CompileCPU="28" CompileMemory="1448"><MemoryGrantInfo SerialRequiredMemory="512" SerialDesiredMemory="544" RequiredMemory="512" DesiredMemory="544" RequestedMemory="1024" GrantWaitTime="0" MaxQueryMemory="407304" GrantedMemory="1024" MaxUsedMemory="16"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="205975" EstimatedPagesCached="102987" EstimatedAvailableDegreeOfParallelism="4" MaxCompileMemory="1559952"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-23T10:20:21.03" ModificationCount="50" SamplingPercent="100" Statistics="[_WA_Sys_00000003_4A4E069C]" Table="[BillingRule]" Schema="[dbo]" Database="[EV_B_TEST]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-23T10:06:20.88" ModificationCount="278" SamplingPercent="100" Statistics="[IX_ChargingOrder_03]" Table="[ChargingOrder]" Schema="[dbo]" Database="[EV_B_TEST]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-23T10:06:20.87" ModificationCount="278" SamplingPercent="100" Statistics="[IX_ChargingOrder_02]" Table="[ChargingOrder]" Schema="[dbo]" Database="[EV_B_TEST]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-23T10:06:22.05" ModificationCount="170" SamplingPercent="100" Statistics="[PK_BillingRule]" Table="[BillingRule]" Schema="[dbo]" Database="[