<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT l.operator_id, l.operator_name, l.station_id, l.station_name, l.period_month,&#xa;       l.detail_count, l.gross_amount, l.platform_fee,&#xa;       l.adjustment_amount, l.carryover_amount, l.payable_amount,&#xa;       diff.diff_count, COALESCE(inv.invoice_amount, 0) AS invoice_amount,&#xa;       l.payable_amount - CAST(COALESCE(inv.invoice_amount, 0) AS DECIMAL(28,2)) AS invoice_balance&#xa;FROM dbo.v_SettlementLedger AS l&#xa;OUTER APPLY (&#xa;    SELECT COUNT(*) AS diff_count FROM dbo.ReconciliationDifference AS d&#xa;    WHERE d.settlement_id = l.settlement_id&#xa;) AS diff&#xa;OUTER APPLY (&#xa;    SELECT SUM(i.amount) AS invoice_amount FROM dbo.SettlementInvoice AS i&#xa;    WHERE i.settlement_id = l.settlement_id AND i.status IN (1, -1)&#xa;) AS inv&#xa;WHERE l.period_month = @period_month&#xa;ORDER BY l.operator_id, l.station_id" StatementId="1" StatementCompId="4" StatementType="SELECT" StatementSqlHandle="0x0900E3CAC09E5EE41E033793649738F7BF8A0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.0389946" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x219A358D9A431999" QueryPlanHash="0xBC5B1732A361D124" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="0" MemoryGrant="1024" NonParallelPlanReason="NoParallelPlansInDesktopOrExpressEdition" CachedPlanSize="144" CompileTime="29" CompileCPU="29" CompileMemory="1728"><MemoryGrantInfo SerialR