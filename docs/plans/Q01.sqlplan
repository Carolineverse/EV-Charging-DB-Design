]" Schema="[dbo]" Database="[EV_B_TEST]"></StatisticsInfo></OptimizerStatsUsage><TraceFlags IsCompileTime="1"><TraceFlag Value="8017" Scope="Global"></TraceFlag></TraceFlags><TraceFlags IsCompileTime="0"><TraceFlag Value="8017" Scope="Global"></TraceFlag></TraceFlags><QueryTimeStats ElapsedTime="1" CpuTime="1"></QueryTimeStats><RelOp NodeId="0" PhysicalOp="Sort" LogicalOp="Sort" EstimateRows="4.78061" EstimateIO="0.0112613" EstimateCPU="0.000117092" AvgRowSize="258" EstimatedTotalSubtreeCost="0.0375492" Parallel="0" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Row"><OutputList><ColumnReference Database="[EV_B_TEST]" Schema="[dbo]" Table="[ChargingStation]" Alias="[s]" Column="station_id"></ColumnReference><ColumnReference Database="[EV_B_TEST]" Schema="[dbo]" Table="[ChargingStation]" Alias="[s]" Column="station_name"></ColumnReference><ColumnReference Database="[EV_B_TEST]" Schema="[dbo]" Table="[ChargingStation]" Alias="[s]" Column="operator_id"></ColumnReference><ColumnReference Database="[EV_B_TEST]" Schema="[dbo]" Table="[Operator]" Alias="[op]" Column="operator_id"></ColumnReference><ColumnReference Database="[EV_B_TEST]" Schema="[dbo]" Table="[Operator]" Alias="[op]" Column="operator_name"></ColumnReference><ColumnReference Column="Expr1014"></ColumnReference><ColumnReference Column="Expr1015"></ColumnReference><ColumnReference Column="Expr1016"></ColumnReference></OutputList><MemoryFractions Input="1" Output="1"></MemoryFractions><RunTimeInformation><RunTimeCountersPerThread Thread="0" ActualRows="25" Batches="0" ActualElapsedms="1" ActualCPUms="1" ActualScans="0" ActualLogicalReads="0" ActualPhysicalReads="0" ActualReadAheads="0" ActualLobLogicalReads="0" ActualLobPhysicalReads="0" ActualLobReadAheads="0" ActualRebinds="1" ActualRewinds="0" ActualEndOfScans="1" ActualExecutions="1" InputMemoryGrant="1024" OutputMemoryGrant="640" UsedMemoryGrant="16" ActualExecutionMode="Row"></RunTimeCountersPerThread></RunTimeInformation><Sort Distinct="