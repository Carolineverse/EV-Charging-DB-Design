<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH pile_count AS&#xa;(&#xa;    SELECT station_id, COUNT(*) AS pile_count&#xa;    FROM dbo.ChargingPile&#xa;    GROUP BY station_id&#xa;), gun_count AS&#xa;(&#xa;    SELECT p.station_id,&#xa;           COUNT(*) AS gun_count,&#xa;           SUM(CASE WHEN g.status = &apos;IDLE&apos; THEN 1 ELSE 0 END) AS idle_gun_count&#xa;    FROM dbo.ChargingPile AS p&#xa;    INNER JOIN dbo.ChargingGun AS g ON g.pile_id = p.pile_id&#xa;    GROUP BY p.station_id&#xa;)&#xa;SELECT op.operator_id,&#xa;       op.operator_name,&#xa;       s.station_id,&#xa;       s.station_name,&#xa;       COALESCE(pc.pile_count, 0) AS pile_count,&#xa;       COALESCE(gc.gun_count, 0) AS gun_count,&#xa;       COALESCE(gc.idle_gun_count, 0) AS idle_gun_count&#xa;FROM dbo.ChargingStation AS s&#xa;INNER JOIN dbo.Operator AS op ON op.operator_id = s.operator_id&#xa;LEFT JOIN pile_count AS pc ON pc.station_id = s.station_id&#xa;LEFT JOIN gun_count AS gc ON gc.station_id = s.station_id&#xa;ORDER BY op.operator_id, s.station_id" StatementId="1" StatementCompId="3" StatementType="SELECT" StatementSqlHandle="0x090098B0951F70DEB58D04F35BC31F8CEE590000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.0623673" StatementEstRows="25" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x6FEC334C4474B59A" QueryPlanHash="0x81E707E9E99C7D10" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="0" MemoryGrant="1024" NonParallelPlanReason