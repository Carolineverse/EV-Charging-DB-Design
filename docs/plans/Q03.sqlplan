<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH detail_summary AS&#xa;(&#xa;    SELECT e.enterprise_settlement_id,&#xa;           COUNT_BIG(*) AS detail_order_count,&#xa;           SUM(d.energy_kwh) AS detail_energy_kwh,&#xa;           SUM(d.payable_amount) AS detail_amount,&#xa;           SUM(CASE WHEN o.end_time &gt;= e.billing_period_start&#xa;                     AND o.end_time &lt; DATEADD(MONTH, 1, e.billing_period_start)&#xa;                    THEN 1 ELSE 0 END) AS order_end_in_period_count,&#xa;           SUM(CASE WHEN o.status = &apos;PAID&apos; AND o.settled_at IS NOT NULL&#xa;                    THEN 1 ELSE 0 END) AS paid_order_count&#xa;    FROM dbo.EnterpriseSettlement AS e&#xa;    INNER JOIN dbo.EnterpriseSettlementDetail AS d&#xa;        ON d.enterprise_settlement_id = e.enterprise_settlement_id&#xa;    INNER JOIN dbo.ChargingOrder AS o ON o.order_id = d.order_id&#xa;    WHERE e.billing_period_start = @BillingPeriodStart&#xa;      AND (@EnterpriseId IS NULL OR e.enterprise_id = @EnterpriseId)&#xa;    GROUP BY e.enterprise_settlement_id&#xa;)&#xa;SELECT e.enterprise_settlement_id,&#xa;       e.enterprise_id,&#xa;       e.billing_period_start,&#xa;       e.total_order_count AS header_order_count,&#xa;       COALESCE(ds.detail_order_count, 0) AS detail_order_count,&#xa;       e.total_energy_kwh AS header_energy_kwh,&#xa;       COALESCE(ds.detail_energy_kwh, 0) AS detail_energy_kwh,&#xa;       e.total_amount AS header_amount,&#xa;       COALESCE(ds.detail_amount, 0) AS detail_amount,&#xa;       COALESCE(ds.order_end_in_period_count, 0) AS order_end_in_period_count,&#xa;       COALESCE(ds.paid_order_count, 0) AS paid_order_count,&#xa;       CASE WHEN e.paid_at IS NOT NULL THEN &apos;PAID&apos;&#xa;            WHEN e.confirmed_at IS NOT NULL THEN &apos;CONFIRMED&apos;&#xa;            ELSE &apos;GENERATED&apos; END AS settlement_state,&#xa;       e.confirmed_at,&#xa;       e.paid_at,&#xa;       e.payment_reference&#xa;FROM dbo.EnterpriseSettlement AS e&#xa;LEFT JOIN detail_summary AS ds&#xa;    ON ds.enterprise_settlement_id = e.enterprise_settlement_id&#xa;WHERE e.billing_period_start = @BillingPeriodStart&#xa;  AND (@EnterpriseId IS NULL OR e.enterprise_id = @EnterpriseId)&#xa;ORDER BY e.enterprise_id, e.enterprise_settlement_id" StatementId="1" StatementCompId="5" StatementType="SELECT" StatementSqlHandle="0x0900815B3B3A25DC97D6EDE9AE7464E39B430000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.026214" StatementEstRows="8.55953" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x6B39B9E6543D65EB" QueryPlanHash="0xD231B7712210C0AD" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="0" NonParallelPlanReason="NoParallelPlansInDesktopOrExpressEdition" CachedPlanSize="104" CompileTime="25" CompileCPU="25" CompileMemory="1416"><MemoryGrantInfo SerialRequiredMemory="0" SerialDesiredMemory="0" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="414379" EstimatedPagesCached="207189" EstimatedAvailableDegreeOfParallelism="4" MaxCompileMemory="11073144"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-23T15:39:44.02" ModificationCount="160" SamplingPercent="100" Statistics="[IX_EnterpriseSettlementDetail_02]" Table="[EnterpriseSettlementDetail]" Schema="[dbo]" Database="[EV_B_TEST]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-23T18:45:56.11" ModificationCount="232" SamplingPercent="100" Statistics="[PK_ChargingOrder]" Table="[ChargingOrder]" Schema="[dbo]" Database="[EV_B_TEST]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-23T15:39:44.02" ModificationCount="218" SamplingPercent="100" Statistics="[PK_EnterpriseSettlement]" Table="[EnterpriseSettlement]" Schema="[dbo]" Database="[EV_B_TEST]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-23T15:39:45.76" ModificationCount="218" SamplingPercent="100" Statistics="[UQ_EnterpriseSettlement_01]" Table="[EnterpriseSettlement]" Schema="[dbo]" Database="[EV_B_TEST]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-23T15:40:43.51" ModificationCount="194" SamplingPercent="100" Statistics="[_WA_Sys_00000003_09FE775D]" Table="[EnterpriseSettlement]" Schema="[dbo]" Database="[EV_B_TEST]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-23T15:39:44.02" ModificationCount="160" SamplingPercent="100" Statistics="[UQ_EnterpriseSettlementDetail_01]" Table="[EnterpriseSettlementDetail]" Schema="[dbo]" Database="[EV_B_TEST]"></StatisticsInfo></OptimizerStatsUsage><TraceFlags IsCompileTime="1"><TraceFlag Value="8017" Scope="Global"></TraceFlag></TraceFlags><TraceFlags IsCompileTime="0"><TraceFlag Value="8017" Scope="Global"></TraceFlag></TraceFlags><QueryTimeStats ElapsedTime="1" CpuTime="1"></QueryTimeStats><RelOp NodeId="0" PhysicalOp="Compute Scalar" LogicalOp="Compute Scalar" EstimateRows="8.55953" EstimateIO="0" EstimateCPU="8.55953e-07" AvgRowSize="183" EstimatedTotalSubtreeCost="0.026214" Parallel="0" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Row"><OutputList><ColumnReference Database="[EV_B_TEST]" Schema="[dbo]" Table="[EnterpriseSettlement]" Alias="[e]" Column="enterprise_settlement_id"></ColumnReference><ColumnReference Database="[EV_B_TEST]" Schema="[dbo]" Table="[EnterpriseSettlement]" Alias="[e]" Column="enterprise_id"></ColumnReference><ColumnReference Database="[EV_B_TEST]" Schema="[dbo]" Table="[EnterpriseSettlement]" Alias="[e